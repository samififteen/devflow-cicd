# DevFlow configuration — copy to .env and adjust. Never commit the real .env.
#
# APP_ENV: development | staging | production | test
# Unknown values are reported as "unknown" in /api/info instead of being trusted.
APP_ENV=development

# Version shown in the UI and /health. Defaults to the value in app/__init__.py.
APP_VERSION=1.0.0

# Development server (python run.py) only. The container ignores this and uses $PORT.
PORT=5000
HOST=127.0.0.1

# Local port published by docker-compose.
HOST_PORT=8000

# Gunicorn worker count inside the container.
WEB_CONCURRENCY=2

# Never enable debug in production. The container sets APP_ENV=production.
FLASK_DEBUG=0

# Build metadata is injected by CI at deploy time; they are optional locally and
# left empty here on purpose:
# GIT_COMMIT=
# GITHUB_RUN_NUMBER=
# GITHUB_REF_NAME=

# ---- Deployment secrets (configure in GitHub / Render, NOT in this file) ----
# RENDER_DEPLOY_HOOK_URL=   -> GitHub Actions secret
# APP_BASE_URL=             -> GitHub Actions repository variable
# DEPLOY_ENABLED=true       -> GitHub Actions repository variable
